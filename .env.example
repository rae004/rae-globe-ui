# Root runtime config, read by docker compose and by every package's settings.
# Copy to .env:
#   cp .env.example .env
# These are local development defaults, not secrets.

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=globe
POSTGRES_PASSWORD=globe
POSTGRES_DB=globe
# Host and port as seen from your machine: compose publishes Postgres here.
# Inside the stack the services use db:5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=55432

# --- Published ports ------------------------------------------------------
API_PORT=8001
UI_PORT=8501

# --- UI -> API ------------------------------------------------------------
# Where the Streamlit app finds the API, as seen from your machine. Inside the
# stack the UI uses http://api:8000.
API_BASE_URL=http://localhost:8001
