# Root runtime config, read by every package's settings. Copy to .env:
#   cp .env.example .env

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=globe
POSTGRES_PASSWORD=globe
POSTGRES_DB=globe
# Host and port as seen from your machine.
POSTGRES_HOST=localhost
POSTGRES_PORT=55432

# --- UI -> API ------------------------------------------------------------
# Where the Streamlit app finds the API, as seen from your machine.
API_BASE_URL=http://localhost:8001
